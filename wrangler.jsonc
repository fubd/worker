{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swan-worker",
  "main": "src/worker/index.ts",
  "rules": [
    {
      "type": "Text",
      "globs": ["dist/server/home-html.txt"],
      "fallthrough": true,
    },
  ],
  "assets": {
    "directory": "./dist/vercel",
    "run_worker_first": ["/home", "/_home/*"],
  },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "virtual:yuyan-home-html": "./dist/server/home-html.txt",
    "virtual:yuyan-home-fresh-html": "./dist/server/home-html-fresh.txt",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://deephos.com",
  },

  // Worker 只保留 API（api.deephos.com）；站点 HTML/静态资源由 Vercel 托管。
  // Cloudflare D1 数据库绑定
  // 首次部署前执行：bun run db:create
  // 然后把输出的 database_id 替换到下面
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swan-worker-db-apac",
      "database_id": "57673fd1-de8d-4f09-b92b-0fd90e7f05e3",
      "migrations_dir": "migrations",
    },
  ],

  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "swan-attachments",
    },
  ],

  "dev": {
    "port": 8787,
  },
}
