{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swan-worker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  // 前端构建产物（rsbuild 输出到 ./dist），由 Workers 静态资源直接托管
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /vendor/* 必须先进 Worker：那里要从 R2 取模块，交给静态资源会命中 SPA 回退
    "run_worker_first": ["/api/*", "/vendor/*"],
  },

  // react 系 vendor 模块存放在 R2，由 Worker 以同源路径 /vendor/* 转发
  // 上传：wrangler r2 object put swan-vendor/<file> --file=<file> --remote
  "r2_buckets": [
    {
      "binding": "VENDOR",
      "bucket_name": "swan-vendor",
    },
  ],

  // Cloudflare D1 数据库绑定
  // 首次部署前执行：bun run db:create
  // 然后把输出的 database_id 替换到下面
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swan-worker-db",
      "database_id": "972f2269-ed6b-4787-aef9-673b37bdf801",
      "migrations_dir": "migrations",
    },
  ],

  "dev": {
    "port": 8787,
  },
}
