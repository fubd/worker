{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swan-worker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  // Worker 只保留 API（api.deephos.com）；站点 HTML/静态资源由 Vercel 托管。
  // Cloudflare D1 数据库绑定
  // 首次部署前执行：bun run db:create
  // 然后把输出的 database_id 替换到下面
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swan-worker-db",
      "database_id": "972f2269-ed6b-4787-aef9-673b37bdf801",
      "migrations_dir": "migrations",
    },
  ],

  "dev": {
    "port": 8787,
  },
}
