{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swan-worker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  // 前端构建产物（rsbuild 输出到 ./dist），由 Workers 静态资源直接托管
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // "/" 要先进 Worker：由 Worker 返回构建期生成的 home.html（静态首屏快照），
    // 快照缺失时回退到 SPA shell。 /home 与 /home.html 只用于把快照文件重定向回 /。
    // /todos、/about 也要进 Worker：大陆用户要拿到 index-cn.html（CN importmap），
    // 否则静态资源层会直接返回全球版 index.html。
    // /vendor/* 不在这里：它和 /static/* 一样由静态资源层直接托管并走边缘缓存。
    "run_worker_first": [
      "/api/*",
      "/",
      "/home",
      "/home.html",
      "/todos",
      "/todos/*",
      "/about",
      "/about/*",
    ],
  },

  // Cloudflare D1 数据库绑定
  // 首次部署前执行：bun run db:create
  // 然后把输出的 database_id 替换到下面
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swan-worker-db",
      "database_id": "972f2269-ed6b-4787-aef9-673b37bdf801",
      "migrations_dir": "migrations",
    },
  ],

  "dev": {
    "port": 8787,
  },
}
