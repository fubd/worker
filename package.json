{
  "name": "swan-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "wrangler dev",
    "dev:web": "bun run vendor && rsbuild dev",
    "vendor": "bun run scripts/build-vendor.ts",
    "vendor-package": "bun run scripts/build-vendor-package.ts",
    "build": "bun run vendor && rsbuild build && bun run build:first-screen && bun run build:cn-html",
    "build:first-screen": "bun scripts/first-screen/index.ts",
    "build:cn-html": "bun scripts/build-cn-html.ts",
    "check:first-screen": "bun scripts/first-screen/check.ts",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "check": "bun check",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --check --no-script",
    "db:create": "wrangler d1 create swan-worker-db",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./seed/seed.sql",
    "db:studio": "wrangler d1 execute DB --local --command=\"select * from todos\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.8",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@rsbuild/core": "^2.3.2",
    "@rsbuild/plugin-react": "^2.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.65.0",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
