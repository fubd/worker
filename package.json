{
  "name": "swan-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "wrangler dev",
    "dev:web": "rsbuild dev --environment web",
    "build": "rsbuild build && bun run build:static && bun run build:vercel && bun run verify:vercel",
    "build:static": "NODE_ENV=production bun scripts/build-static.ts",
    "build:vercel": "bun scripts/build-vercel.ts",
    "verify:vercel": "bun scripts/verify-vercel-assets.ts",
    "perf:api": "bun scripts/perf-probe.ts",
    "perf:budget": "size-limit",
    "perf:lighthouse": "bun node_modules/@lhci/cli/src/cli.js autorun",
    "perf:check": "bun run perf:budget && bun run perf:lighthouse",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "check": "bun check",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --check --no-script",
    "db:create": "wrangler d1 create swan-worker-db",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:studio": "wrangler d1 execute DB --local --command=\"select id,title,owner_id,version,deleted_at from documents order by updated_at desc\""
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@vercel/speed-insights": "^2.1.0",
    "antd": "^6.6.8",
    "dompurify": "^3.5.0",
    "hono": "^4.13.14",
    "lucide-react": "^1.77.0",
    "nanoid": "^6.0.2",
    "oauth4webapi": "3.8.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@lhci/cli": "^0.16.1",
    "@rsbuild/core": "^2.3.2",
    "@rsbuild/plugin-react": "^2.1.1",
    "@size-limit/file": "^14.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "size-limit": "^14.3.0",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
