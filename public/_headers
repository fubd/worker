# Cloudflare Workers 静态资源响应头（构建时随 public/ 拷到 dist/）

# 带 hash 的产物可以永久缓存
/static/*
  Cache-Control: public, max-age=31536000, immutable

# vendor 文件名带 react 版本号，内容变了必然改名，可以永久缓存
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# HTML 入口必须每次回源校验，否则发版后用户会拿到旧壳
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# 大陆版 HTML 由 Worker 按 cf.country 选择，响应本身会再设 private/no-store；
# 这里保证内部 ASSETS.fetch 也不会把两个版本混进共享缓存
/index-cn
  Cache-Control: no-cache

/index-cn.html
  Cache-Control: no-cache

/home-cn
  Cache-Control: no-cache

/home-cn.html
  Cache-Control: no-cache

# 其余静态文件（favicon 等）
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
