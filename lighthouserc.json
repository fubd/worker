{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/login",
        "http://127.0.0.1:4173/docs"
      ],
      "startServerCommand": "bun scripts/perf-server.ts",
      "startServerReadyPattern": "perf server ready",
      "startServerReadyTimeout": 15000,
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 4,
          "requestLatencyMs": 0,
          "downloadThroughputKbps": 0,
          "uploadThroughputKbps": 0
        },
        "skipAudits": [
          "is-on-https",
          "redirects-http",
          "uses-http2",
          "service-worker",
          "valid-source-maps"
        ]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:4173/(?:login)?$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "first-contentful-paint": ["error", { "maxNumericValue": 1800 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "total-blocking-time": ["error", { "maxNumericValue": 400 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "server-response-time": ["warn", { "maxNumericValue": 500 }]
          }
        },
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:4173/docs(?:\\?.*)?$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.65 }],
            "first-contentful-paint": ["error", { "maxNumericValue": 1800 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "total-blocking-time": ["error", { "maxNumericValue": 600 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "server-response-time": ["warn", { "maxNumericValue": 500 }]
          }
        }
      ]
    }
  }
}
