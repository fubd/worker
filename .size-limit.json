  },
  {
    "name": "docs route",
    "path": [
      "dist/vercel/static/js/async/*.mjs",
      "!dist/vercel/static/js/async/share-page.*.mjs",
      "!dist/vercel/static/js/async/share-dompurify.*.mjs"
    ],
    "limit": "205 kB"
  },
  {
    "name": "share route",
    "path": [
      "dist/vercel/static/js/async/share-page.*.mjs",
      "dist/vercel/static/js/async/share-dompurify.*.mjs"
    ],
    "limit": "20 kB"
  },
  {
